# Copy to .env.local and restart the local development server after changes.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Exact Ollama tag for the existing "Qwen 7B" selection.
OLLAMA_MODEL_QWEN_7B=qwen2.5:7b

# Optional local conversation storage directory. Defaults to the OS app-data folder.
# REBEL_AI_DATA_DIR=/absolute/path/to/rebel-ai-data
